# Flattrade API credentials (from https://wall.flattrade.in → Pi → API Key)
# Copy this file to .env and fill in values. Never commit .env.
FLATTRADE_USER_ID=
FLATTRADE_API_KEY=
FLATTRADE_API_SECRET=
# Optional: fully automated daily login (TOTP secret from Flattrade web → Profile → Security → TOTP)
FLATTRADE_PASSWORD=
FLATTRADE_TOTP_SECRET=
# Generated daily via OAuth — run: python scripts/flattrade_login.py
FLATTRADE_ACCESS_TOKEN=
# Must match the Redirect URL registered with your Flattrade API key
FLATTRADE_REDIRECT_URL=http://127.0.0.1:8000/callback
# Optional: local token cache (default .flattrade/session.json)
FLATTRADE_TOKEN_FILE=.flattrade/session.json

# Runtime
TRADING_MODE=paper
CONFIG_DIR=./config
LOG_LEVEL=INFO

# Database (Docker Compose defaults — override on server)
POSTGRES_USER=algomcx
POSTGRES_PASSWORD=algomcx
POSTGRES_DB=algomcx
DATABASE_URL=postgresql://algomcx:algomcx@postgres:5432/algomcx

# Optional service ports (host mapping)
WEB_PORT=8080
ENGINE_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379

# Optional
REDIS_URL=redis://redis:6379/0

# Web dashboard login (change before production!)
WEB_USERNAME=admin
WEB_PASSWORD=algomcx
JWT_SECRET=change-me-use-long-random-string
